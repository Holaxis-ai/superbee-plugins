{
  "name": "@superbee/integration-github",
  "version": "0.1.0-pre.1",
  "type": "module",
  "description": "GitHub repository issue source profile and Work Item recipes for Superbee.",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Holaxis-ai/superbee-plugins.git",
    "directory": "integrations/github"
  },
  "main": "./dist/profile.mjs",
  "types": "./dist/profile.d.ts",
  "exports": {
    ".": {
      "types": "./dist/profile.d.ts",
      "default": "./dist/profile.mjs"
    },
    "./profile": {
      "types": "./dist/profile.d.ts",
      "default": "./dist/profile.mjs"
    },
    "./recipes": {
      "types": "./dist/recipes.d.ts",
      "default": "./dist/recipes.mjs"
    }
  },
  "files": [
    "dist",
    "recipes",
    "fixtures",
    "PROFILE.md"
  ],
  "sideEffects": false,
  "superbeeIntegration": {
    "contract": 1,
    "id": "github",
    "core": "0.2.0-pre.39",
    "profiles": [
      {
        "id": "github-issues",
        "version": 2,
        "entry": "dist/profile.mjs"
      }
    ],
    "recipes": {
      "source-feeds": "recipes/source-feeds",
      "work-items": "recipes/work-items"
    }
  },
  "scripts": {
    "build": "node build.mjs",
    "typecheck": "tsc --noEmit",
    "test": "node --test --import tsx test/*.test.ts",
    "prepublishOnly": "node -e \"console.error('Integration npm publication is disabled; build and register a reviewed pinned repository folder'); process.exit(1)\""
  },
  "peerDependencies": {
    "@superbee/core": "0.2.0-pre.39"
  },
  "peerDependenciesMeta": {
    "@superbee/core": {
      "optional": true
    }
  },
  "homepage": "https://github.com/Holaxis-ai/superbee-plugins/tree/main/integrations/github",
  "bugs": {
    "url": "https://github.com/Holaxis-ai/superbee-plugins/issues"
  },
  "private": true
}
